{
  "version": 2,
  "builds": [
    {
      "src": "api/claude.js",
      "use": "@vercel/node",
      "config": { "includeFiles": "node_modules/pdf-parse/lib/**" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/claude", "dest": "/api/claude.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
